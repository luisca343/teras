# Gradle / build. Anchored to the repo root on purpose: unanchored `build/` and `run/` match a
# directory of that name at ANY depth, which silently excluded the whole of
# src/main/java/.../dungeon/build (the materializer) and .../dungeon/run (the floor loop) — 12
# source files that were never committed and that a fresh clone could not compile without.
.gradle/
/build/
/run/
legacy-1.16/build/
legacy-1.16/run/
bin/
out/

# IDE
.idea/
*.iml
.vscode/tasks.json
.vscode/launch.json
.eclipse/
.settings/
.classpath
.project

# Compiled / logs / crashes
*.class
*.log
hs_err_pid*
replay_pid*

# Packages
*.war
*.nar
*.ear

docs